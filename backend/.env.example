# Local dev
DATABASE_URL=postgres://localhost:5432/jc_command_center
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
NODE_ENV=development

# Production (Render) — set these in the Render dashboard, not in a file:
#   DATABASE_URL   the managed Postgres connection string (TLS is handled automatically)
#   JWT_SECRET     a long random string; changing it signs everyone out
#   NODE_ENV       production
#   CORS_ORIGINS   https://your-app.vercel.app
#                  Leave empty if the frontend proxies /api through its own domain.
